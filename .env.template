# WARNING: This file contains sensitive credentials.
# Do NOT commit this file to version control.
# Consider using a password manager or keyring instead of storing passwords here.

# Handshake credentials for auto-login
# WARNING: Storing passwords in plain text is insecure.
# Consider using a keyring library or environment variable injection instead.
HANDSHAKE_EMAIL=your_email@example.com
HANDSHAKE_PASSWORD=your_password_here

# Handshake host — swap per university (e.g., binghamton.joinhandshake.com)
HANDSHAKE_HOST=app.joinhandshake.com

# Chrome configuration (optional)
# Set this if Chrome is installed in a non-standard location
# CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_USER_DATA=~/Library/Application Support/Google/Chrome
# Chrome profile name for cookie extraction and browser automation
# Common values: "Default", "Profile 1", "Profile 2"
CHROME_PROFILE=Default

# Maximum HAR file size to process (in MB); files larger than this are skipped
MAX_HAR_SIZE_MB=50

# Gemini API Key for AI resume matching
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
