{
  "name": "handshook-extension",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "description": "Handshook — an automated job application assistant for Handshake",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "package": "node scripts/package.ts",
    "ingest-capture": "node scripts/ingest-capture.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "live": "node scripts/live/cli.ts",
    "live:start": "node scripts/live/harness.ts",
    "live:login": "node scripts/live/harness.ts --login",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
